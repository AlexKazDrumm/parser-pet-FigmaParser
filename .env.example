# Токен Figma REST API
FIGMA_TOKEN=

# Ключ для AI-режимов
OPENAI_API_KEY=

# Сервер
HOST=127.0.0.1
PORT=8000

# HTTP-клиент
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2
HTTP_MAX_RESPONSE_BYTES=26214400

# Ограничения запросов
MAX_SELECTED_IDS=200
MAX_UPLOAD_BYTES=8388608
REQUEST_BODY_LIMIT_BYTES=2097152

# Модель для AI-режимов
OPENAI_DEFAULT_MODEL=gpt-4o
